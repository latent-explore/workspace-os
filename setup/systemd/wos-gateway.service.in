[Unit]
Description=Workspace OS gateway (Telegram -> Claude Code)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=@REPO@/system
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
Environment=WOS_CLAUDE_BIN=@CLAUDE@
ExecStart=@REPO@/system/.venv/bin/python -m gateway
Restart=always
RestartSec=5
# Agents are children of this service, so this caps the gateway and all agents together.
# Leaves the rest of the machine (RAM, cores) for local LLMs. MemoryHigh slows things before MemoryMax kills them.
MemoryHigh=28G
MemoryMax=32G
CPUQuota=400%

[Install]
WantedBy=default.target
